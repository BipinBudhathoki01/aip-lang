[
  {
    "name": "nested collections",
    "source": "system:\nRole {{ $role }}\nuser:\nHello {{ $name }} {{ $name }}\ngenerate as Payload { schema: { author: { name: string, verified: bool }, matrix: list[list[int]], scores: dict[string, float] } }",
    "expected": {
      "variables": [
        "role",
        "name"
      ],
      "schema": {
        "type": "object",
        "properties": {
          "author": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "verified": {
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "verified"
            ]
          },
          "matrix": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          },
          "scores": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          }
        },
        "required": [
          "author",
          "matrix",
          "scores"
        ],
        "title": "Payload"
      }
    }
  },
  {
    "name": "aliases",
    "source": "user:\nAliases\ngenerate {schema:{i:integer,n:number,s:str,b:boolean,arr:array[float],lookup:map[str,bool]}}",
    "expected": {
      "variables": [],
      "schema": {
        "type": "object",
        "properties": {
          "i": {
            "type": "integer"
          },
          "n": {
            "type": "number"
          },
          "s": {
            "type": "string"
          },
          "b": {
            "type": "boolean"
          },
          "arr": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "lookup": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          }
        },
        "required": [
          "i",
          "n",
          "s",
          "b",
          "arr",
          "lookup"
        ]
      }
    }
  },
  {
    "name": "trailing commas and empty objects",
    "source": "user:\nHello\ngenerate as Empty { schema: { empty: {}, tags: list[string], }, }",
    "expected": {
      "variables": [],
      "schema": {
        "type": "object",
        "properties": {
          "empty": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "empty",
          "tags"
        ],
        "title": "Empty"
      }
    }
  },
  {
    "name": "quoted punctuation and unicode",
    "source": "user:\nHello {{ $person }}\ngenerate {model: \"mødel, schema: {नमस्ते}\", temperature: -2e-1, provider: \"ollama\", max_tokens: 123, schema:{answer:string}}",
    "expected": {
      "variables": [
        "person"
      ],
      "schema": {
        "type": "object",
        "properties": {
          "answer": {
            "type": "string"
          }
        },
        "required": [
          "answer"
        ]
      },
      "model": "mødel, schema: {नमस्ते}",
      "temperature": -0.2,
      "options": {
        "provider": "ollama",
        "max_tokens": 123
      }
    }
  },
  {
    "name": "inline reserved markers stay text",
    "source": "user:\nExplain system: text, user: text and generate { examples }.\ngenerate as Inline {schema:{ok:bool}}",
    "expected": {
      "variables": [],
      "schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "title": "Inline"
      },
      "user_contains": "system: text, user: text and generate { examples }"
    }
  },
  {
    "name": "line headers remain boundaries",
    "source": "user:\nFirst {{ $first }}\nsystem:\nSecond {{ $second }}",
    "expected": {
      "variables": [
        "second",
        "first"
      ],
      "schema": null
    }
  },
  {
    "name": "generate without prompts",
    "source": "generate {schema:{}}",
    "expected": {
      "variables": [],
      "schema": {
        "type": "object",
        "properties": {},
        "required": []
      }
    }
  },
  {
    "name": "numeric configuration and escaped string",
    "source": "user:\nHello\ngenerate {model:\"model\\\"name\",temperature:+.5,schema:{ok:bool}}",
    "expected": {
      "variables": [],
      "schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ]
      },
      "model": "model\"name",
      "temperature": 0.5
    }
  },
  {
    "name": "empty input",
    "source": "",
    "invalid": true
  },
  {
    "name": "leading junk",
    "source": "junk\nuser:\nHello",
    "invalid": true
  },
  {
