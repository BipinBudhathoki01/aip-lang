    "source": "user:\nHello\ngenerate {model:\"model\" schema:{score:int}}",
    "invalid": true
  },
  {
    "name": "mismatched brackets",
    "source": "user:\nHello\ngenerate {schema:{score:list[int}}",
    "invalid": true
  },
  {
    "name": "single quoted string",
    "source": "user:\nHello\ngenerate {model:'model'}",
    "invalid": true
  },
  {
