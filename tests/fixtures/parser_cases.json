  {
    "name": "bare collection",
    "source": "user:\nHello\ngenerate {schema:{score:list}}",
    "invalid": true
  },
  {
    "name": "non-string dictionary key",
    "source": "user:\nHello\ngenerate {schema:{score:dict[int,bool]}}",
    "invalid": true
  },
  {
    "name": "trailing junk",
