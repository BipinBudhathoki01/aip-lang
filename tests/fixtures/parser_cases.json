    "invalid": true
  },
  {
    "name": "empty user",
    "source": "user:",
    "invalid": true
  },
  {
    "name": "malformed named declaration",
    "source": "user:\nHello\ngenerate as {schema:{score:int}}",
    "invalid": true
  },
  {
    "name": "inline section after generate",
    "source": "generate {schema:{}} user: Hello",
    "invalid": true
  },
  {
    "name": "split prompt header",
    "source": "user\n: Hello",
    "invalid": true
  },
  {
    "name": "non-string provider",
